# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- OpenAI: each team member redeems their own $50 event credit ---
# Put every member's key here and round-robin, so one exhausted quota
# does not stop the demo at 14:50.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# --- OpenRouter: the Challenger must run on a non-OpenAI model ---
OPENROUTER_API_KEY=
CHALLENGER_MODEL=

# --- Channels ---
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- Sponsors ---
EXA_API_KEY=
TRIGGER_SECRET_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
