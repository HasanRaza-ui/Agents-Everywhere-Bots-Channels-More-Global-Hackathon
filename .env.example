# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- OpenAI: each team member redeems their own $50 event credit ---
# Put every member's key here and round-robin, so one exhausted quota
# does not stop the demo at 14:50.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# --- Vision perception: an OpenAI model that accepts images ---
VISION_MODEL=

# --- OpenRouter: the Challenger must run on a non-OpenAI model ---
# A model checking its own work is not a check.
OPENROUTER_API_KEY=
CHALLENGER_MODEL=

# --- Channels ---
# Caregiver chat id: from getUpdates, result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CAREGIVER_CHAT_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- Tuning ---
SAMPLE_SECONDS=4
CHECKIN_WINDOW_SECONDS=30
CONCERN_STREAK_REQUIRED=2
COOLDOWN_SECONDS=60

# --- Sponsors (optional for this build) ---
EXA_API_KEY=
TRIGGER_SECRET_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
